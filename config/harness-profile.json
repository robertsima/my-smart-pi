{
  "schemaVersion": 1,
  "managedPackages": [
    "npm:@tintinweb/pi-subagents@0.14.3",
    "npm:pi-claude-auth@0.1.3"
  ],
  "removedPackages": [
    "npm:pi-open-tui"
  ],
  "packageExtensionFilters": {
    "npm:@kylebrodeur/pi-model-discovery": [
      "!dist/index.js"
    ],
    "npm:@kylebrodeur/pi-model-router": [
      "!extensions/index.ts"
    ]
  },
  "routingPolicy": {
    "apiProviders": ["openai-codex"],
    "apiRoles": ["planner", "verifier"],
    "localRoles": ["implementer", "reviewer"],
    "localProvider": "llama-local",
    "maxLocalParallel": 1
  },
  "npmDependencies": {
    "@aliou/pi-guardrails": "0.16.0",
    "@kylebrodeur/pi-model-discovery": "0.7.24",
    "@kylebrodeur/pi-model-router": "0.3.0",
    "@ollama/pi-web-search": "^0.0.5",
    "@tintinweb/pi-subagents": "0.14.3",
    "@xenova/transformers": "2.17.2",
    "apache-arrow": "18.1.0",
    "pi-caveman": "1.0.7",
    "pi-claude-auth": "0.1.3",
    "pi-context": "2.1.2",
    "pi-llama-switch": "1.0.2",
    "@lancedb/lancedb": "0.33.0",
    "pi-vault-mind": "0.16.25",
    "pi-web-access": "0.15.0"
  },
  "subagents": {
    "maxConcurrent": 4,
    "maxSubagentDepth": 2,
    "defaultMaxTurns": 18,
    "graceTurns": 3,
    "defaultJoinMode": "smart",
    "schedulingEnabled": false,
    "scopeModels": true,
    "fleetView": true,
    "widgetMode": "off",
    "outputTranscript": true,
    "toolDescriptionMode": "compact",
    "disableDefaultAgents": true
  },
  "agentTemplates": {
    "planner": "harness-api-planner.md",
    "verifier": "harness-api-verifier.md",
    "implementer": "harness-local-implementer.md",
    "reviewer": "harness-local-reviewer.md"
  }
}
