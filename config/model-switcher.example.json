{
  "version": 1,
  "server": {
    "host": "127.0.0.1",
    "port": 8086,
    "healthTimeout": 60,
    "portReleaseTimeout": 30
  },
  "defaultModel": "qwen",
  "models": {
    "qwen": {
      "name": "Qwen3 30B Coder",
      "description": "Default / Balanced 54K",
      "command": [
        "llama-server",
        "-m", "<PATH_TO_GGUF>",
        "--jinja",
        "--reasoning", "off",
        "-ngl", "all",
        "-ot", "blk\\.([0-9]*[02468])\\.ffn_.*_exps\\.=CPU",
        "--ctx-size", "65536",
        "--n-predict", "8192",
        "--no-context-shift",
        "-b", "1024",
        "-ub", "512",
        "-t", "8",
        "-tb", "16",
        "--parallel", "1",
        "--flash-attn", "on",
        "--cache-type-k", "q8_0",
        "--cache-type-v", "q8_0",
        "--temp", "0.7",
        "--top-p", "0.8",
        "--top-k", "20",
        "--repeat-penalty", "1.05",
        "--presence-penalty", "0.0",
        "--fit-target", "1536",
        "--metrics",
        "--host", "127.0.0.1",
        "--port", "8086"
      ],
      "vision": false,
      "contextWindow": 65536,
      "maxTokens": 8192,
      "compaction": {
        "enabled": true,
        "reserveTokens": 12288,
        "keepRecentTokens": 16000
      },
      "branchSummary": {
        "reserveTokens": 8192
      },
      "tags": ["coding", "balanced"]
    },
    "qwen-lc": {
      "name": "Qwen3 30B Coder LC",
      "description": "Long Context 95K",
      "command": [
        "llama-server",
        "-m", "<PATH_TO_GGUF>",
        "--jinja",
        "--reasoning", "off",
        "-ngl", "33",
        "-c", "95000",
        "-b", "1024",
        "-ub", "256",
        "-t", "8",
        "-tb", "16",
        "--parallel", "1",
        "--flash-attn", "on",
        "--cache-type-k", "q8_0",
        "--cache-type-v", "q8_0",
        "--temp", "0.6",
        "--top-p", "0.8",
        "--top-k", "20",
        "--repeat-penalty", "1.1",
        "--host", "127.0.0.1",
        "--port", "8086"
      ],
      "vision": false,
      "contextWindow": 95000,
      "maxTokens": 4096,
      "tags": ["coding", "long-context"]
    },
    "qwen-lc-cpu-moe": {
      "name": "Qwen3 30B Coder LC CPU MoE",
      "description": "Max Context / CPU MoE 100K",
      "command": [
        "llama-server",
        "-m", "<PATH_TO_GGUF>",
        "--jinja",
        "--reasoning", "off",
        "-ngl", "33",
        "--cpu-moe",
        "-c", "100000",
        "-b", "1024",
        "-ub", "256",
        "-t", "8",
        "-tb", "16",
        "--parallel", "1",
        "--flash-attn", "on",
        "--cache-type-k", "q8_0",
        "--cache-type-v", "q8_0",
        "--temp", "0.5",
        "--top-p", "0.8",
        "--top-k", "20",
        "--repeat-penalty", "1.1",
        "--host", "127.0.0.1",
        "--port", "8086"
      ],
      "vision": false,
      "contextWindow": 100000,
      "maxTokens": 4096,
      "tags": ["coding", "max-context", "cpu-moe"]
    }
  }
}
