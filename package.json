{
  "name": "my-smart-pi",
  "version": "0.1.1",
  "description": "Shareable Pi harness package: API/llama.cpp agent routing, tapered context, lazy tools, and vault indexing.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "llm",
    "agent",
    "vault",
    "context-management"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsima/my-smart-pi.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "apply-profile": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/apply-harness-profile.ps1",
    "doctor": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/doctor.ps1",
    "patch-runtime": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/patch-runtime-packages.ps1",
    "test": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/test-harness-profile.ps1"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
